# Django backend environment
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
# Comma separated origins allowed to call the API (the Next.js app)
CORS_ALLOWED_ORIGINS=http://localhost:3000
# AI extraction webhook. Django calls this with the invoice image and expects
# the Smart Compta extraction JSON back (the Make scenario must end with a
# "Webhook Response" module). Markdown ```json fences in the reply are tolerated.
WEBHOOK_URL=https://hook.we.make.com/your-scenario-id
# How the image reaches the webhook:
#   "multipart" -> raw binary `file` field; map it to the AI module's file_input
#   "base64"    -> JSON data URI (inline)
#   "url"       -> upload to Cloudinary, send a public URL (only if the AI can
#                  fetch URLs)
WEBHOOK_IMAGE_MODE=multipart

# Cloudinary media storage (avatars, invoice images). Format:
#   cloudinary://<api_key>:<api_secret>@<cloud_name>
# Leave empty to store media on local disk (dev). Set on Render for persistence.
CLOUDINARY_URL=

# Cloudflare R2 private storage for message attachments and other uploaded files.
# Leave empty to keep the local MEDIA_ROOT storage in development.
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_REGION_NAME=auto